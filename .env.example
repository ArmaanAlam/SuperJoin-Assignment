# LLM 1 - Knowledge Builder (Fact Extraction & Normalization)
EXTRACTION_LLM_PROVIDER=gemini
EXTRACTION_LLM_API_KEY=
EXTRACTION_LLM_MODEL=gemini-1.5-flash

# LLM 2 - Independent Reasoner (Cross-Document Judgment)
REASONING_LLM_PROVIDER=gemini
REASONING_LLM_API_KEY=
REASONING_LLM_MODEL=gemini-1.5-pro

# Vector Embeddings (Local BGE or Sentence-Transformers)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Database Connection (PostgreSQL + pgvector or fallback SQLite)
DATABASE_URL=sqlite:///./fact_knowledge.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fact_knowledge

# Hybrid Retrieval Settings
SIMILARITY_THRESHOLD=0.50
TOP_K_CANDIDATES=15

# Chunking & Document Processing
CHUNK_SIZE=800
CHUNK_OVERLAP=150
